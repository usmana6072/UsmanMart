<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F8F9FA"
    tools:context=".forms.StoreFormActivity">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingTop="40dp"
            android:paddingEnd="20dp"
            android:paddingBottom="30dp">

            <TextView
                android:id="@+id/textView4"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="25dp"
                android:fontFamily="@font/alatsi"
                android:gravity="center"
                android:text="Create Your Store"
                android:textColor="#1B5E20"
                android:textSize="26sp"
                android:textStyle="bold" />

            <!-- Store Name -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Store Name"
                android:textColor="#212121"
                android:textSize="14sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/etStoreName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:background="@drawable/singup_tv_bg"
                android:hint="Enter store name"
                android:maxHeight="50dp"
                android:maxLength="30"
                android:padding="10dp"
                android:singleLine="true"
                android:textColor="#212121"
                android:textColorHint="#757575" />

            <!-- Seller Phone -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="15dp"
                android:text="Seller Phone"
                android:textColor="#212121"
                android:textSize="14sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/etSellerPhone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:background="@drawable/singup_tv_bg"
                android:hint="Enter phone number"
                android:inputType="phone"
                android:maxHeight="50dp"
                android:padding="10dp"
                android:textColor="#212121"
                android:textColorHint="#757575" />

            <!-- Category -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="15dp"
                android:text="Category"
                android:textColor="#212121"
                android:textSize="14sp"
                android:textStyle="bold" />

            <Spinner
                android:id="@+id/spinner"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:background="@drawable/singup_tv_bg" />

            <!-- Address -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="15dp"
                android:text="Address"
                android:textColor="#212121"
                android:textSize="14sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/etAddress"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:background="@drawable/singup_tv_bg"
                android:hint="Enter seller address"
                android:inputType="textMultiLine"
                android:isScrollContainer="true"
                android:maxHeight="80dp"
                android:maxLength="200"
                android:minHeight="50dp"
                android:padding="10dp"
                android:scrollIndicators="left"
                android:textColor="#212121"
                android:textColorHint="#757575" />

            <!-- Description -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="15dp"
                android:text="Description"
                android:textColor="#212121"
                android:textSize="14sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/etStoreDes"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:background="@drawable/singup_tv_bg"
                android:hint="Enter store description"
                android:inputType="textMultiLine"
                android:scrollbars="vertical"
                android:overScrollMode="always"
                android:maxHeight="150dp"
                android:maxLength="400"
                android:minHeight="80dp"
                android:padding="10dp"
                android:scrollIndicators="left"
                android:textColor="#212121"
                android:textColorHint="#757575" />

            <!-- Upload Logo -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="Upload Logo"
                android:textColor="#212121"
                android:textSize="14sp"
                android:textStyle="bold" />

            <ImageView
                android:id="@+id/imageViewLogo"
                android:layout_width="120dp"
                android:layout_height="120dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/singup_tv_bg"
                android:padding="20dp"
                app:srcCompat="@drawable/image" />

            <!-- Save Button -->
            <Button
                android:id="@+id/button"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="25dp"
                android:background="@drawable/save_continue_btn_bg"
                android:textColor="#FFFFFF"
                android:text="Save and Continue"
                android:textStyle="bold"
                android:padding="12dp" />

        </LinearLayout>

    </ScrollView>

</LinearLayout>