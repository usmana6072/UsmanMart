<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#1B5E20"
    tools:context=".forms.AddProductActivity">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="15dp"
        android:background="#1B5E20"
        android:minHeight="?attr/actionBarSize"
        android:theme="?attr/actionBarTheme">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            tools:layout_editor_absoluteX="-40dp"
            tools:layout_editor_absoluteY="0dp">

            <ImageView
                android:id="@+id/backArrow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintVertical_bias="0.5"
                app:srcCompat="@drawable/back"
                app:tint="@color/white" />

            <TextView
                android:id="@+id/textView3"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:text="Add New Product"
                android:textColor="@color/white"
                android:textSize="20sp"
                android:textStyle="bold"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toEndOf="@+id/backArrow"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintVertical_bias="0.5" />

        </androidx.constraintlayout.widget.ConstraintLayout>

    </androidx.appcompat.widget.Toolbar>
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#F8F9FA"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:text="Product Name"
            android:textColor="#212121"
            android:textSize="14sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etProductName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:background="@drawable/singup_tv_bg"
            android:hint="Enter Product Title"
            android:maxHeight="50dp"
            android:maxLength="100"
            android:padding="10dp"
            android:singleLine="true"
            android:textColor="#212121"
            android:textColorHint="#757575" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:text="Product Price"
            android:textColor="#212121"
            android:textSize="14sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etProductPrice"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ems="10"
            android:inputType="number"
            android:layout_marginTop="6dp"
            android:background="@drawable/singup_tv_bg"
            android:hint="Enter Product Price"
            android:maxHeight="50dp"
            android:maxLength="100"
            android:padding="10dp"
            android:singleLine="true"
            android:textColor="#212121"
            android:textColorHint="#757575"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:text="Product Quantity"
            android:textColor="#212121"
            android:textSize="14sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etProductQuantity"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ems="10"
            android:inputType="number"
            android:layout_marginTop="6dp"
            android:background="@drawable/singup_tv_bg"
            android:hint="Enter Product Quantity"
            android:maxHeight="50dp"
            android:maxLength="100"
            android:padding="10dp"
            android:singleLine="true"
            android:textColor="#212121"
            android:textColorHint="#757575"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:text="Select Category"
            android:textColor="#212121"
            android:textSize="14sp"
            android:textStyle="bold" />

        <Spinner
            android:id="@+id/spinner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:background="@drawable/singup_tv_bg" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:text="Bullet Points"
            android:textColor="#212121"
            android:textSize="14sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:background="#F8F9FA">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="1: "
                android:textColor="#212121"
                android:textSize="14sp"
                android:textStyle="bold"
                android:layout_marginEnd="6dp"/>

            <EditText
                android:id="@+id/etBulletPoint1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:background="@drawable/singup_tv_bg"
                android:hint="Enter first BulletPoint "
                android:maxHeight="50dp"
                android:maxLength="100"
                android:padding="10dp"
                android:singleLine="true"
                android:textColor="#212121"
                android:textColorHint="#757575" />

        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:background="#F8F9FA">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="2: "
                android:textColor="#212121"
                android:textSize="14sp"
                android:textStyle="bold"
                android:layout_marginEnd="6dp"/>

            <EditText
                android:id="@+id/etBulletPoint2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:background="@drawable/singup_tv_bg"
                android:hint="Enter second point"
                android:maxHeight="50dp"
                android:maxLength="100"
                android:padding="10dp"
                android:singleLine="true"
                android:textColor="#212121"
                android:textColorHint="#757575" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:background="#F8F9FA">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="3: "
                android:textColor="#212121"
                android:textSize="14sp"
                android:textStyle="bold"
                android:layout_marginEnd="6dp"/>

            <EditText
                android:id="@+id/etBulletPoint3"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:background="@drawable/singup_tv_bg"
                android:hint="Enter third point"
                android:maxHeight="50dp"
                android:maxLength="100"
                android:padding="10dp"
                android:singleLine="true"
                android:textColor="#212121"
                android:textColorHint="#757575" />

        </LinearLayout>


        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:text="Description"
            android:textColor="#212121"
            android:textSize="14sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etProductDes"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:background="@drawable/singup_tv_bg"
            android:hint="Enter store description"
            android:inputType="textMultiLine"
            android:scrollbars="vertical"
            android:overScrollMode="always"
            android:maxHeight="150dp"
            android:maxLength="800"
            android:minHeight="80dp"
            android:padding="10dp"
            android:scrollIndicators="left"
            android:textColor="#212121"
            android:textColorHint="#757575" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:text="@string/enter_search_terms_related_to_your_product"
            android:textColor="#212121"
            android:textSize="14sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etTags"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:background="@drawable/singup_tv_bg"
            android:hint="@string/enter_search_terms_related_to_your_product_to_improve_ranking_in_search"
            android:inputType="textMultiLine"
            android:scrollbars="vertical"
            android:overScrollMode="always"
            android:maxHeight="80dp"
            android:maxLength="150"
            android:minHeight="80dp"
            android:padding="10dp"
            android:scrollIndicators="left"
            android:textColor="#212121"
            android:textColorHint="#757575" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:layout_marginBottom="8dp"
            android:text="Select  Images (Atleast one)"
            android:textColor="#212121"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:layout_marginBottom="8dp"
            android:text="For good result image should be 1080 *1080"
            android:textColor="#212121"
            android:textSize="14sp"
            android:textStyle="bold" />
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="5dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="5dp">

                <ImageView
                    android:id="@+id/productImage1"
                    android:layout_width="100dp"
                    android:layout_height="100dp"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/singup_tv_bg"
                    android:padding="20dp"
                    android:scaleType="centerCrop"
                    app:srcCompat="@drawable/image" />

                <ImageView
                    android:id="@+id/productImage2"
                    android:layout_width="100dp"
                    android:layout_height="100dp"
                    android:layout_marginLeft="5dp"
                    android:layout_marginTop="8dp"
                    android:layout_marginRight="5dp"
                    android:background="@drawable/singup_tv_bg"
                    android:padding="20dp"
                    android:scaleType="centerCrop"
                    app:srcCompat="@drawable/image" />

                <ImageView
                    android:id="@+id/productImage3"
                    android:layout_width="100dp"
                    android:layout_height="100dp"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/singup_tv_bg"
                    android:padding="20dp"
                    android:scaleType="centerCrop"
                    app:srcCompat="@drawable/image" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="5dp">

                <ImageView
                    android:id="@+id/productImage4"
                    android:layout_width="100dp"
                    android:layout_height="100dp"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/singup_tv_bg"
                    android:padding="20dp"
                    android:scaleType="centerCrop"
                    app:srcCompat="@drawable/image" />

                <ImageView
                    android:id="@+id/productImage5"
                    android:layout_width="100dp"
                    android:layout_height="100dp"
                    android:layout_marginLeft="5dp"
                    android:layout_marginTop="8dp"
                    android:layout_marginRight="5dp"
                    android:background="@drawable/singup_tv_bg"
                    android:padding="20dp"
                    android:scaleType="centerCrop"
                    app:srcCompat="@drawable/image" />

                <ImageView
                    android:id="@+id/productImage6"
                    android:layout_width="100dp"
                    android:layout_height="100dp"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/singup_tv_bg"
                    android:padding="20dp"
                    android:scaleType="centerCrop"
                    app:srcCompat="@drawable/image" />
            </LinearLayout>
        </LinearLayout>
        <Button
            android:id="@+id/uploadButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="25dp"
            android:background="@drawable/save_continue_btn_bg"
            android:textColor="#FFFFFF"
            android:text="Upload Product"
            android:textStyle="bold"
            android:padding="12dp" />

    </LinearLayout>
    </ScrollView>
</LinearLayout>